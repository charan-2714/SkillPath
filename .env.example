# SkillPath Firebase Configuration
# Copy this file to .env or .env.local and populate with your Firebase Project credentials

VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
VITE_FIREBASE_AUTH_DOMAIN=skillpath-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=skillpath-app
VITE_FIREBASE_STORAGE_BUCKET=skillpath-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Authorized Master Curriculum Admin Emails (comma-separated, e.g. admin@yourdomain.com,charan@gmail.com)
VITE_ADMIN_EMAILS=admin@yourdomain.com

