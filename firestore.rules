rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and data root
    match /users/{userId} {
      // Allow user to read and write their own profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User's independent journeys subcollection
      match /journeys/{journeyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's study session learning logs subcollection
      match /learningLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's recycle bin for soft-deleted items (journeys, levels, subjects, topics, etc.)
      match /recycleBin/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's settings and preferences
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
